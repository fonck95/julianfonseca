---
// Hero: ave que evoluciona dentro de un viento real (Navier–Stokes),
// con un cerebro transformer — en PC y en móvil.
//
// POR QUÉ TODO VA INLINE: el motor vivía en un módulo externo cuyo único
// punto de fallo era la petición HTTP (MIME/base/servidor estático). Aquí se
// lee del disco en el build y se incrusta en el HTML: si la página se ve, el
// ave corre.
//
// POR QUÉ EN PARTES: el motor son ~1 500 líneas y vive partido en public/hero/
// (core → fluido → política → criatura → render → boot → entrada) para poder
// escribir y validar cada pieza por separado. Este frontmatter las concatena
// EN ORDEN en un solo script clásico: las seis primeras partes cuelgan de
// window.__HERO__ y la última arranca; si falta alguna, el HUD lo dice en vez
// de morir en silencio.
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const HERO_PARTS = [
  '00-core.js',
  '10-fluid.js',
  '20-policy.js',
  '30-creature.js',
  '40-render.js',
  '50-boot.js',
  '99-entry.js',
];

const heroDir = fileURLToPath(new URL('../../public/hero/', import.meta.url));
const heroJs = HERO_PARTS.map(
  (f) => readFileSync(new URL(f, `file://${heroDir}`), 'utf-8'),
).join('\n;\n');

// `</script>` dentro del código cortaría el bloque: no lo hay, y si alguien lo
// añade el build debe fallar de forma ruidosa y no servir HTML roto.
if (/<\/script/i.test(heroJs)) {
  throw new Error('public/hero/*.js contiene "</script>": no se puede incrustar en el HTML.');
}
---

<canvas id="neural" aria-hidden="true"></canvas>

<div class="hud" id="hud" role="status" aria-live="off">
  <div class="hud-head">
    <span class="hud-dot" id="hud-dot"></span>
    <span class="hud-title">Evolución en vivo</span>
    <span class="hud-loc">Navier–Stokes · CPU</span>
  </div>

  <ol class="hud-stages" id="hud-stages">
    <li data-stage="0"><span class="st-dot"></span> caminar</li>
    <li data-stage="1"><span class="st-dot"></span> saltar</li>
    <li data-stage="2"><span class="st-dot"></span> volar</li>
  </ol>

  <svg class="hud-graph" id="hud-graph" viewBox="0 0 160 46" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="45" x2="160" y2="45" stroke="rgba(255,255,255,.12)" stroke-width="0.6" />
    <line id="hud-goal" x1="0" y1="13.5" x2="160" y2="13.5" stroke="rgba(255,199,89,.35)" stroke-width="0.5"
      stroke-dasharray="3 4" />
    <polyline id="hud-curve" fill="none" stroke="url(#gHud)" stroke-width="1.4"
      stroke-linejoin="round" stroke-linecap="round" points="" />
    <defs>
      <linearGradient id="gHud" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ff5b73" />
        <stop offset="1" stop-color="#59d7ff" />
      </linearGradient>
    </defs>
  </svg>

  <dl class="hud-rows">
    <div><dt>aptitud</dt><dd id="hud-fit">—</dd></div>
    <div><dt>distancia</dt><dd id="hud-err">—</dd></div>
    <div><dt>sustentación</dt><dd id="hud-lift">—</dd></div>
    <div><dt>simulaciones</dt><dd id="hud-steps">0</dd></div>
  </dl>
  <p class="hud-msg" id="hud-msg">cerebro al azar: el ave ni se sostiene…</p>
  <button class="hud-reset" id="hud-reset" type="button">Reiniciar desde cero</button>
</div>

<style>
  #neural { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hud {
    position: absolute; right: 24px; bottom: 92px; z-index: 3;
    width: min(290px, calc(100% - 48px));
    padding: 14px 16px 15px;
    border: 1px solid var(--line); border-radius: 14px;
    background: rgba(8, 11, 22, 0.72);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.4);
    font-family: var(--font-body);
  }
  .hud-head { display: flex; align-items: center; gap: 8px; }
  .hud-dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--gold);
    box-shadow: 0 0 10px rgba(255, 199, 89, 0.8);
    animation: hudPulse 1.6s ease-in-out infinite;
  }
  .hud-dot.converged { background: var(--cyan); box-shadow: 0 0 10px rgba(89, 215, 255, 0.8); animation: none; }
  @keyframes hudPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .hud-title {
    font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text); font-weight: 600;
  }
  .hud-loc { margin-left: auto; font-size: 0.6rem; color: var(--muted); letter-spacing: 0.06em; }

  .hud-stages {
    list-style: none; margin: 12px 0 0; padding: 0;
    display: flex; gap: 6px;
  }
  .hud-stages li {
    flex: 1; display: flex; align-items: center; gap: 5px;
    padding: 5px 7px; border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 0.64rem; letter-spacing: 0.06em; text-transform: lowercase;
    color: var(--muted); transition: color 0.3s, border-color 0.3s, background 0.3s;
  }
  .hud-stages .st-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.18); flex-shrink: 0;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .hud-stages li.now {
    color: var(--text); border-color: rgba(255, 199, 89, 0.45);
    background: rgba(255, 199, 89, 0.08);
  }
  .hud-stages li.now .st-dot {
    background: var(--gold); box-shadow: 0 0 8px rgba(255, 199, 89, 0.9);
    animation: hudPulse 1.1s ease-in-out infinite;
  }
  .hud-stages li.done { color: var(--cyan); border-color: rgba(89, 215, 255, 0.32); }
  .hud-stages li.done .st-dot { background: var(--cyan); box-shadow: 0 0 6px rgba(89, 215, 255, 0.7); animation: none; }

  .hud-graph { display: block; width: 100%; height: 42px; margin-top: 11px; }
  .hud-rows {
    display: grid; grid-template-columns: 1fr 1fr; gap: 7px 12px;
    margin: 11px 0 0;
  }
  .hud-rows > div { display: flex; flex-direction: column; gap: 1px; }
  .hud-rows dt {
    font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
  }
  .hud-rows dd {
    margin: 0; font-variant-numeric: tabular-nums;
    font-size: 0.78rem; font-weight: 600; color: var(--text);
  }
  .hud-msg {
    margin: 10px 0 0; font-size: 0.72rem; line-height: 1.45; color: var(--muted);
    min-height: 2.1em;
  }
  .hud-reset {
    margin-top: 10px; width: 100%;
    font: inherit; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted); background: transparent;
    border: 1px solid var(--line); border-radius: 9px;
    padding: 7px 0; cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .hud-reset:hover { color: var(--text); border-color: rgba(255, 91, 115, 0.5); background: rgba(255, 91, 115, 0.07); }
  @media (max-width: 860px) {
    .hud { right: 12px; left: 12px; bottom: 12px; width: auto; padding: 12px 13px 13px; }
    .hud-graph { height: 32px; margin-top: 9px; }
    .hud-rows { gap: 6px 10px; }
    .hud-msg { font-size: 0.68rem; }
  }
  @media (max-width: 420px) {
    .hud-graph { display: none; }
    .hud-stages li { font-size: 0.58rem; padding: 4px 5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hud-dot, .hud-stages li.now .st-dot { animation: none; }
  }
</style>

<script is:inline set:html={heroJs} />
