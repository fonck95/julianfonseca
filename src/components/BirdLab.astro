---
// BirdLab — WIDGET EXCLUSIVO del ave evolutiva: escenario, telemetría y motor
// viven dentro de su propio marco y no interactúan con el resto de la página.
//
// Antes el canvas era un fondo absoluto de todo el hero: los textos (H1, nota,
// métricas) y el HUD flotaban ENCIMA del escenario, tapando al ave — en móvil
// el HUD cubría el suelo entero y el ave «nunca llegaba a verse». Aquí el
// escenario es un elemento propio con su marco: arriba la cabecera, en medio
// el canvas (solo ave, viento y objetivo) y abajo la telemetría. Nada se
// superpone al canvas.
//
// El motor sigue incrustado inline en el build (mismo mecanismo anti-MIME):
// se leen las partes de public/hero/ en orden y se concatenan en un script
// clásico; si falta alguna, el HUD lo dice en vez de morir en silencio.
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const HERO_PARTS = [
  '00-core.js',
  '10-fluid.js',
  '20-policy.js',
  '30-creature.js',
  '40-render.js',
  '50-boot.js',
  '99-entry.js',
];

const heroDir = fileURLToPath(new URL('../../public/hero/', import.meta.url));
const heroJs = HERO_PARTS.map(
  (f) => readFileSync(new URL(f, `file://${heroDir}`), 'utf-8'),
).join('\n;\n');

if (/<\/script/i.test(heroJs)) {
  throw new Error('public/hero/*.js contiene "</script>": no se puede incrustar en el HTML.');
}
---

<section class="lab" id="lab" aria-label="Laboratorio del ave evolutiva">
  <div class="lab-frame">
    <header class="lab-head">
      <span class="lab-dot" aria-hidden="true"></span>
      <div class="lab-heading">
        <h2 class="lab-title">ave · evolución en vivo</h2>
        <p class="lab-sub">
          Su cerebro transformer evoluciona en tu navegador: aprende a
          <strong>caminar</strong>, luego a <strong>saltar</strong> y luego a
          <strong>volar</strong> dentro de un viento real resuelto con Navier–Stokes.
          Mueve el cursor (o el dedo) sobre el escenario: lo persigue y tus gestos
          crean ráfagas.
        </p>
      </div>
      <div class="lab-reward-wrap">
        <button class="lab-reward" id="hud-reward" type="button" title="Premia lo que acabas de ver: la búsqueda se enfoca alrededor del campeón actual">Recompensar</button>
        <span class="lab-reward-count" id="hud-rewards">0</span>
      </div>
      <button class="lab-reset" id="hud-reset" type="button">Reiniciar</button>
    </header>

    <div class="lab-stage">
      <canvas id="neural" aria-hidden="true"></canvas>
    </div>

    <footer class="lab-foot">
      <ol class="hud-stages" id="hud-stages">
        <li data-stage="0"><span class="st-dot"></span> caminar</li>
        <li data-stage="1"><span class="st-dot"></span> saltar</li>
        <li data-stage="2"><span class="st-dot"></span> volar</li>
      </ol>
      <svg class="hud-graph" id="hud-graph" viewBox="0 0 160 46" preserveAspectRatio="none" aria-hidden="true">
        <line x1="0" y1="45" x2="160" y2="45" stroke="rgba(255,255,255,.12)" stroke-width="0.6" />
        <line id="hud-goal" x1="0" y1="13.5" x2="160" y2="13.5" stroke="rgba(255,199,89,.35)" stroke-width="0.5"
          stroke-dasharray="3 4" />
        <polyline id="hud-curve" fill="none" stroke="url(#gHud)" stroke-width="1.4"
          stroke-linejoin="round" stroke-linecap="round" points="" />
        <defs>
          <linearGradient id="gHud" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#ff5b73" />
            <stop offset="1" stop-color="#59d7ff" />
          </linearGradient>
        </defs>
      </svg>
      <dl class="hud-rows">
        <div><dt>aptitud</dt><dd id="hud-fit">—</dd></div>
        <div><dt>distancia</dt><dd id="hud-err">—</dd></div>
        <div><dt>sustentación</dt><dd id="hud-lift">—</dd></div>
        <div><dt>simulaciones</dt><dd id="hud-steps">0</dd></div>
      </dl>
      <p class="hud-msg" id="hud-msg">cerebro al azar: el ave ni se sostiene…</p>
    </footer>
  </div>
</section>

<style>
  .lab { position: relative; z-index: 2; width: min(1120px, 100% - 48px); margin: 0 auto; }
  .lab-frame {
    border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
    background: #070a14;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
  }

  .lab-head {
    display: flex; align-items: center; gap: 12px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(10, 13, 24, 0.66);
  }
  .lab-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
    background: var(--gold); box-shadow: 0 0 10px rgba(255, 199, 89, 0.8);
    animation: labPulse 1.6s ease-in-out infinite;
  }
  @keyframes labPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .lab-heading { min-width: 0; }
  .lab-title {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--text);
  }
  .lab-sub { margin: 3px 0 0; font-size: 0.76rem; line-height: 1.5; color: var(--muted); max-width: 72ch; }
  .lab-sub strong { color: var(--text); font-weight: 600; }
  .lab-reward-wrap { margin-left: auto; display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .lab-reward { font: inherit; font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; color: #0a0d18; background: linear-gradient(95deg, var(--gold), #ffd98a); border: 0; border-radius: 9px; padding: 9px 14px; cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; }
  .lab-reward:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(255, 199, 89, 0.35); }
  .lab-reward:active { transform: scale(0.96); }
  .lab-reward.pulse { animation: rewardPulse 0.5s ease; }
  @keyframes rewardPulse { 0% { box-shadow: 0 0 0 0 rgba(255,199,89,.6); } 100% { box-shadow: 0 0 0 18px rgba(255,199,89,0); } }
  .lab-reward-count { min-width: 22px; text-align: center; font-size: 0.7rem; font-weight: 700; color: var(--gold); font-variant-numeric: tabular-nums; }
  .lab-reset {
    flex-shrink: 0;
    font: inherit; font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted); background: transparent;
    border: 1px solid var(--line); border-radius: 9px;
    padding: 8px 14px; cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .lab-reset:hover { color: var(--text); border-color: rgba(255, 91, 115, 0.5); background: rgba(255, 91, 115, 0.07); }

  /* EL ESCENARIO: solo el canvas — nada flota encima */
  .lab-stage {
    position: relative;
    height: clamp(320px, 54svh, 560px);
    touch-action: none; /* el dedo crea ráfagas sin hacer scroll de la página */
  }
  #neural { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .lab-foot {
    display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 14px 20px;
    align-items: center;
    padding: 12px 16px 14px;
    border-top: 1px solid var(--line);
    background: rgba(10, 13, 24, 0.66);
  }
  .hud-stages { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .hud-stages li {
    display: flex; align-items: center; gap: 7px;
    padding: 5px 9px; border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 0.66rem; letter-spacing: 0.06em; text-transform: lowercase;
    color: var(--muted); transition: color 0.3s, border-color 0.3s, background 0.3s;
  }
  .hud-stages .st-dot {
    width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0;
    background: rgba(255, 255, 255, 0.18);
    transition: background 0.3s, box-shadow 0.3s;
  }
  .hud-stages li.now { color: var(--text); border-color: rgba(255, 199, 89, 0.45); background: rgba(255, 199, 89, 0.08); }
  .hud-stages li.now .st-dot { background: var(--gold); box-shadow: 0 0 8px rgba(255, 199, 89, 0.9); animation: labPulse 1.1s ease-in-out infinite; }
  .hud-stages li.done { color: var(--cyan); border-color: rgba(89, 215, 255, 0.32); }
  .hud-stages li.done .st-dot { background: var(--cyan); box-shadow: 0 0 6px rgba(89, 215, 255, 0.7); animation: none; }

  .hud-graph { display: block; width: 100%; height: 52px; }
  .hud-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 12px; margin: 0; }
  .hud-rows > div { display: flex; flex-direction: column; gap: 1px; }
  .hud-rows dt { font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .hud-rows dd {
    margin: 0; font-variant-numeric: tabular-nums;
    font-size: 0.8rem; font-weight: 600; color: var(--text);
  }
  .hud-msg {
    grid-column: 1 / -1; margin: 2px 0 0;
    font-size: 0.72rem; line-height: 1.45; color: var(--muted);
  }

  @media (max-width: 860px) {
    .lab { width: calc(100% - 24px); }
    .lab-head { flex-wrap: wrap; padding: 11px 13px; }
    .lab-reset { margin-left: auto; }
    .lab-sub { font-size: 0.7rem; }
    .lab-stage { height: clamp(280px, 44svh, 380px); }
    .lab-foot { grid-template-columns: 1fr 1fr; gap: 10px 14px; padding: 11px 13px 13px; }
    .hud-graph { grid-column: 1 / -1; height: 34px; }
    .hud-msg { font-size: 0.68rem; }
  }
  @media (max-width: 420px) {
    .lab-sub { display: none; } /* la cabecera queda en una línea: título + botón */
    .hud-graph { display: none; }
    .hud-stages li { font-size: 0.6rem; padding: 4px 7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-dot, .hud-stages li.now .st-dot { animation: none; }
  }
</style>

<script is:inline set:html={heroJs} />
